# Modèle des variables attendues. `make secrets` génère .env et .env.api remplis.
# Ce fichier est versionné, les deux autres non.

# --- .env : variables d'interpolation de docker compose ---
# Interfaces d'écoute. 127.0.0.1 en développement : le LAN a des IPv6 publiques que la
# box ne filtre pas, donc 0.0.0.0 exposerait MLflow, Airflow & co. sur Internet.
# En production les deux valent l'IP LAN de la VM (cf. deployement/README.md).
HOST_BIND=127.0.0.1
API_BIND=127.0.0.1
DECISION_THRESHOLD=0.5
DRIFT_SHARE_THRESHOLD=0.5
ALERT_WEBHOOK_URL=

# Mots de passe en clair, pour les appels locaux du Makefile. Jamais déployés.
API_CLIENT_PASSWORD=
API_ADMIN_PASSWORD=

# --- .env.api : lu directement par le conteneur ---
# Les $ des hachages bcrypt doivent y être doublés, sinon compose les mange et
# l'API reçoit un hachage tronqué. `make secrets` le fait.
JWT_SECRET_KEY=CHANGEME
JWT_EXPIRE_MINUTES=60
API_CLIENT_USER=client
API_CLIENT_PASSWORD_HASH=
API_ADMIN_USER=admin
API_ADMIN_PASSWORD_HASH=
